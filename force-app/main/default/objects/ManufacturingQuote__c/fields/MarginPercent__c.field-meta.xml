<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MarginPercent__c</fullName>
    <description>Calculated gross margin percentage for the manufacturing quote.</description>
    <formula>IF(BLANKVALUE(QuotedPrice__c, 0) = 0, 0, BLANKVALUE(MarginAmount__c, 0) / QuotedPrice__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Automatically calculated as Margin Amount divided by Quoted Price.</inlineHelpText>
    <label>Margin Percent</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <securityClassification>Confidential</securityClassification>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
