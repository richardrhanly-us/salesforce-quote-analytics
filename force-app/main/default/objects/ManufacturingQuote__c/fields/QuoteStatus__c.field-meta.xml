<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>QuoteStatus__c</fullName>
    <description>Tracks the current stage of a manufacturing quote through the quoting and approval process.</description>
    <inlineHelpText>Select the current stage of the quote, from Draft through Won or Lost.</inlineHelpText>
    <label>Quote Status</label>
    <required>false</required>
    <securityClassification>Internal</securityClassification>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>true</sorted>
            <value>
                <fullName>Approved</fullName>
                <default>false</default>
                <label>Approved</label>
            </value>
            <value>
                <fullName>Draft</fullName>
                <default>true</default>
                <label>Draft</label>
            </value>
            <value>
                <fullName>In Review</fullName>
                <default>false</default>
                <label>In Review</label>
            </value>
            <value>
                <fullName>Lost</fullName>
                <default>false</default>
                <label>Lost</label>
            </value>
            <value>
                <fullName>Rejected</fullName>
                <default>false</default>
                <label>Rejected</label>
            </value>
            <value>
                <fullName>Sent to Customer</fullName>
                <default>false</default>
                <label>Sent to Customer</label>
            </value>
            <value>
                <fullName>Won</fullName>
                <default>false</default>
                <label>Won</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
